{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/customer", "destination": "/index.html" },
    { "source": "/submit", "destination": "/submit.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/staff", "destination": "/staff.html" }
  ]
}
